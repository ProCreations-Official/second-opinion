#!/usr/bin/env python3
"""Second Opinion CLI.

Installs lightweight agent skills and lets one coding agent delegate a scoped
task to another installed coding agent.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path
from textwrap import dedent
from typing import Callable, Iterable


VERSION = "1.5.0"
DEFAULT_BASE_URL = "https://second-opinion.ssh.codes"
SKILL_NAME = "second-opinion"
MARKER = "<!-- Generated by Second Opinion. Managed file. -->"
MANAGER_CHOICES = ("app", "terminal", "none")
DETACHED_PROCESSES: list[subprocess.Popen] = []


def track_detached_process(process: subprocess.Popen) -> None:
    DETACHED_PROCESSES.append(process)


def reap_detached_processes() -> None:
    DETACHED_PROCESSES[:] = [process for process in DETACHED_PROCESSES if process.poll() is None]


@dataclass(frozen=True)
